DATABASE_URL="file:./prisma/dev.db"
DEFAULT_COUNTRY="Mexico"
DEFAULT_STATE="Zacatecas"
DEFAULT_FISCAL_YEAR=2026
NEXT_PUBLIC_APP_NAME="EMPS-Fresnillo"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# --- Integracion con el chatbot de ROSBECLOUD (POST /api/chatbot-quote) ---
# Llave compartida server-to-server; debe ser IGUAL a EMPS_API_KEY en el .env de
# ROSBECLOUD. Sin ella el endpoint responde 503 (integracion apagada).
CHATBOT_API_KEY=
# Codigo privado del vendedor para recuperar el workspace "chatbot-rosbecloud"
# en la UI (formato XXXX-XXXX). Si falta, cae al legacy RSBE-CHAT.
CHATBOT_WORKSPACE_RECOVERY_CODE=
