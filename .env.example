DATABASE_URL="file:./prisma/dev.db"
DEFAULT_COUNTRY="Mexico"
DEFAULT_STATE="Zacatecas"
DEFAULT_FISCAL_YEAR=2026
NEXT_PUBLIC_APP_NAME="EMPS-Fresnillo"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# --- Integracion con el chatbot de ROSBECLOUD (POST /api/chatbot-quote) ---
# Llave compartida server-to-server; debe ser IGUAL a EMPS_API_KEY en el .env de
# ROSBECLOUD. Sin ella el endpoint responde 503 (integracion apagada).
CHATBOT_API_KEY=
# Codigo privado del vendedor para recuperar el workspace "chatbot-rosbecloud"
# en la UI (formato XXXX-XXXX). Si falta, cae al legacy RSBE-CHAT.
CHATBOT_WORKSPACE_RECOVERY_CODE=

# --- Panel del investigador (/investigacion y APIs de investigacion) ---
# Cadena larga y aleatoria. Es la unica llave del panel: sin ella isAdmin()
# siempre devuelve false y el panel queda inaccesible (decision deliberada).
ADMIN_SECRET=

# --- Observatorio de comentarios (/investigacion/observatorio) ---
# Clave de API de Google Cloud con "YouTube Data API v3" habilitada.
# Cuota gratis: 10,000 unidades al dia (leer comentarios cuesta 1 unidad por
# cada 100; buscar videos cuesta 100 por llamada). Sin ella, cosechar da 503.
YOUTUBE_API_KEY=
# Clave de la API de Anthropic para analizar cada comentario. Sin ella,
# analizar da 503. La cosecha sigue funcionando.
ANTHROPIC_API_KEY=
# Tope de gasto mensual en dolares para el analisis. Al llegar al tope el
# endpoint se detiene y avisa, en lugar de seguir gastando.
OBSERVATORIO_TOPE_MENSUAL_USD=25

# --- Dos caras, un solo sistema (lib/lado.ts) ---
# Hosts (sin puerto, separados por coma) que muestran la cara de ayuntamientos.
# Cualquier otro host, incluidas las llamadas internas a 127.0.0.1, muestra la
# cara del desarrollador. En local: http://ayuntamientos.localhost:3003
HOSTS_AYUNTAMIENTO=ayuntamientos.hazlatarea.com,ayuntamientos.localhost
# Lado cuando el host no está en la lista: desarrollador (por omisión) o ayuntamiento.
LADO_POR_OMISION=desarrollador
